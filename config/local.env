# Local docker-compose target. The gateway runs in dev mode so dev-token-* is accepted.
TARGET_ENV=local
GATEWAY_REST_URL=http://localhost:9001
GATEWAY_WS_URL=ws://localhost:9001/ws
AUTH_MODE=dev-token

# UI E2E: the React client served by docker-compose's `client` service.
CLIENT_BASE_URL=http://localhost:5173

# Eventual consistency timeouts (ms). Local is fast.
POLL_TIMEOUT_MS=5000
POLL_INTERVAL_MS=200

# Matchmaking + WS waits (ms).
WS_HANDSHAKE_TIMEOUT_MS=5000
MATCH_FOUND_TIMEOUT_MS=15000
GAME_STATE_TIMEOUT_MS=5000
GAME_OVER_TIMEOUT_MS=10000
