# Google Cloud dev target. Uses real Firebase auth on overload-party-dev project.
# Auth: ADC + service account impersonation (no SA keys are issued).
#
# NOTE: dev environment is normally shut down to save cost. Spin it up via the
# overload-party-infra runbook before running tests.
TARGET_ENV=dev
GATEWAY_REST_URL=https://overloadparty-dev.keyandnotes.com
GATEWAY_WS_URL=wss://overloadparty-dev.keyandnotes.com/ws
AUTH_MODE=firebase

# dev is closer to local in latency than stg (smaller fleet).
POLL_TIMEOUT_MS=10000
POLL_INTERVAL_MS=300

WS_HANDSHAKE_TIMEOUT_MS=8000
MATCH_FOUND_TIMEOUT_MS=20000
GAME_STATE_TIMEOUT_MS=8000
GAME_OVER_TIMEOUT_MS=15000

FIREBASE_PROJECT_ID=overload-party-dev
# Firebase Web API key は Firebase クライアントに公開される識別子で秘密ではない。
FIREBASE_TEST_API_KEY=AIzaSyCxyTXiZ9MCELgc1kFfWh3En8wIQukMG4E
