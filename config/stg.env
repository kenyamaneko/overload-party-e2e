# Google Cloud stg target. Uses real Firebase auth via service account impersonation.
# Auth: ADC + service account impersonation (no SA keys are issued).
#
# NOTE: stg environment is normally shut down to save cost. Spin it up via the
# overload-party-infra runbook before running tests.
#
# GATEWAY_* hosts are the Cloud Run auto-assigned URL of the gateway service in overload-party-stg.
TARGET_ENV=stg
GATEWAY_REST_URL=https://gateway-2kzsleaapa-an.a.run.app
GATEWAY_WS_URL=wss://gateway-2kzsleaapa-an.a.run.app/ws
AUTH_MODE=firebase

# stg has higher latency budgets.
POLL_TIMEOUT_MS=15000
POLL_INTERVAL_MS=500

WS_HANDSHAKE_TIMEOUT_MS=10000
MATCH_FOUND_TIMEOUT_MS=30000
GAME_STATE_TIMEOUT_MS=10000
GAME_OVER_TIMEOUT_MS=20000

FIREBASE_PROJECT_ID=overload-party-stg
# Firebase Web API key は Firebase クライアントに公開される識別子で秘密ではない。
FIREBASE_TEST_API_KEY=AIzaSyBXSfdJMI6qTfM_DfA8QuUTxe6aYtVXEWY
